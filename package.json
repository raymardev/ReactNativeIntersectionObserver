{
  "name": "react-native-intersection-observer",
  "version": "1.0.0",
  "description": "A powerful React Native hook for detecting scroll intersections with ScrollView, FlatList, and SectionList components",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "__docs__"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.{ts,tsx}",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "semantic-release": "semantic-release"
  },
  "keywords": [
    "react-native",
    "intersection-observer",
    "scroll",
    "scrollview",
    "flatlist",
    "sectionlist",
    "hooks",
    "typescript",
    "detection",
    "visibility"
  ],
  "author": "Ray Martin <raymardev> (https://raymartin.es)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/raymardev/ReactNativeIntersectionObserver.git"
  },
  "bugs": {
    "url": "https://github.com/raymardev/ReactNativeIntersectionObserver/issues"
  },
  "homepage": "https://github.com/raymardev/ReactNativeIntersectionObserver#readme",
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-native": ">=0.60.0"
  },
  "devDependencies": {
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/react-native": "^12.4.0",
    "@types/jest": "^29.5.0",
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.72.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "^4.1.0",
    "jest": "^29.6.0",
    "jest-environment-jsdom": "^29.6.0",
    "prettier": "^3.0.0",
    "react-native-gesture-handler": "^2.12.0",
    "react-test-renderer": "^18.2.0",
    "semantic-release": "^21.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.1.0"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "release": {
    "branches": [
      "main",
      "master",
      {
        "name": "beta",
        "prerelease": true
      }
    ]
  }
}
