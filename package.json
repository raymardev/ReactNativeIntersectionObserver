{
  "name": "@raymardev/react-native-intersection-observer",
  "version": "1.0.0",
  "description": "A powerful React Native hook for detecting scroll intersections with ScrollView, FlatList, and SectionList components",
  "main": "dist/index.js",
  "react-native": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/__tests__",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "__docs__"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && node -e \"require('./dist/index.js'); require('fs').accessSync('dist/index.d.ts')\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "npm run clean",
    "semantic-release": "semantic-release"
  },
  "keywords": [
    "react-native",
    "intersection-observer",
    "scroll",
    "scrollview",
    "flatlist",
    "sectionlist",
    "hooks",
    "typescript",
    "detection",
    "visibility"
  ],
  "author": "Ray Martin <raymardev> (https://raymartin.es)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raymardev/ReactNativeIntersectionObserver.git"
  },
  "bugs": {
    "url": "https://github.com/raymardev/ReactNativeIntersectionObserver/issues"
  },
  "homepage": "https://github.com/raymardev/ReactNativeIntersectionObserver#readme",
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-native": ">=0.60.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@react-native/babel-preset": "^0.73.21",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@testing-library/react-native": "^12.4.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "^4.1.0",
    "jest": "^29.6.0",
    "prettier": "^3.0.0",
    "react": "18.2.0",
    "react-native": "0.73.6",
    "react-test-renderer": "18.2.0",
    "semantic-release": "^21.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
